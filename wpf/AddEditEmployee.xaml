<Window x:Class="wpf.AddEditEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:AddEditEmployee, IsDesignTimeCreatable=True}"
        Title="AddEditEmployee" FontSize="25" Height="450" Width="400"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Icon="resources/bookshop2.png">

    <Window.Resources>
        <Style x:Key="ButtonAddStyle" TargetType="Button">
        <Setter Property="Background" Value="#E91E63"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="BorderBrush" Value="#08091c"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#08091c"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="-10" Color="#E91E63" RenderingBias="Quality" BlurRadius="10"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Background="#08091c">
        <StackPanel Margin="20">
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="First Name:"></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbFirstName" Background="WhiteSmoke" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" FontWeight="Medium" Foreground="White" Content="Last Name:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbLastName" Background="WhiteSmoke" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" FontWeight="Medium" Foreground="White" Content="Phone Number:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbPhoneNumber" Background="WhiteSmoke" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" FontWeight="Medium" Foreground="White" Content="Address :" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40"  Name="tbAddress" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="WhiteSmoke" Margin="0,3" />
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" FontWeight="Medium" Foreground="White" Content="Department:" ></Label>
                <ComboBox HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,3" FontSize="16" Width="150" Height="40" Background="WhiteSmoke" Name="comboDeparyment">
                    <ComboBoxItem  FontWeight="Medium" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16" >Production</ComboBoxItem>
                    <ComboBoxItem  FontWeight="Medium" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16">Sales</ComboBoxItem>
                    <ComboBoxItem  FontWeight="Medium" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16">Advertisement</ComboBoxItem>
                    <ComboBoxItem  FontWeight="Medium" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16">Management</ComboBoxItem>
                </ComboBox>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" FontWeight="Medium" Foreground="White" Content="Bace Salary:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" Name="tbSalary" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="WhiteSmoke" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <Label Name="lblerorr" HorizontalAlignment="Right" Foreground="Red" FontSize="15" Margin="2"/>
            <DockPanel Margin="1,10,0,0" HorizontalAlignment="Right">
                <Button Margin="10,10,10,10" Height="30" Width="70" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Cancel" Style="{StaticResource ButtonAddStyle}" FontSize="18" CommandParameter="{Binding}" Click="btnCansel_Click"/>
                <Button Margin="0,0,0,0" Height="30" Width="70" Content="OK" Background="White" Foreground="Black" FontWeight="Medium" Style="{StaticResource ButtonAddStyle}" FontSize="18" CommandParameter="{Binding}" Click="btnOK_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
