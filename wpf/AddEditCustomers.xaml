<Window x:Class="wpf.AddEditCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf"
        mc:Ignorable="d"
        Title="AddEditCustomers" FontSize="25" Height="350" Width="390"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow"
        Icon="resources/bookshop2.png">
    <Window.Resources>
        <Style x:Key="ButtonAddStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderBrush" Value="#08091c"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#08091c"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="-10" Color="#E91E63" RenderingBias="Quality" BlurRadius="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#08091c">
        <StackPanel Margin="20">
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="First Name:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbFirstNamec" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Last Name:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbLastNamec" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Phone Number:"></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbPhoneNumberc" Margin="0,3" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Adress:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Name="tbAddressc" Margin="0,3" />
            </DockPanel>
            <Label Name="lblError" HorizontalAlignment="Right" VerticalAlignment="Stretch" Foreground="Red" FontSize="15" Margin="2"/>
            <DockPanel Margin="0,10,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Right">
                <Button Margin="10" Height="30" Width="70" Name="btnCancelc"  Style="{StaticResource ButtonAddStyle}" FontSize="18" CommandParameter="{Binding}" Click="btnCancelc_Click">Cancel</Button>
                <Button Height="30" Width="70" x:Name="btnOKc" Background="White" Foreground="Black" FontWeight="Medium"  Style="{StaticResource ButtonAddStyle}" FontSize="18" CommandParameter="{Binding}" Click="btnOKc_Click">OK</Button>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
