<Window
    x:Class="wpf.AddEditCustomer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AddEditCustomers"
    Width="390"
    Height="350"
    FontSize="25"
    Icon="resources/bookshop2.png"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ThreeDBorderWindow"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="ButtonAddStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Height" Value="50" />
            <Setter Property="BorderBrush" Value="#08091c" />
            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#08091c" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            RenderingBias="Quality"
                                            ShadowDepth="-10"
                                            Color="#E91E63" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#08091c">
        <StackPanel Margin="20">
            <DockPanel Margin="1">
                <Label
                    Margin="2"
                    Content="First Name:"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="White" />
                <TextBox
                    Name="tbFirstNamec"
                    Width="150"
                    Height="40"
                    Margin="0,3"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="16"
                    TextChanged="ValidateTextInput" />
            </DockPanel>
            <DockPanel Margin="1">
                <Label
                    Margin="2"
                    Content="Last Name:"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="White" />
                <TextBox
                    Name="tbLastNamec"
                    Width="150"
                    Height="40"
                    Margin="0,3"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="16"
                    TextChanged="ValidateTextInput" />
            </DockPanel>
            <DockPanel Margin="1">
                <Label
                    Margin="2"
                    Content="Phone Number:"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="White" />
                <TextBox
                    Name="tbPhoneNumberc"
                    Width="150"
                    Height="40"
                    Margin="0,3"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="16"
                    TextChanged="ValidateTextInput" />
            </DockPanel>
            <DockPanel Margin="1">
                <Label
                    Margin="2"
                    Content="Adress:"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="White" />
                <TextBox
                    Name="tbAddressc"
                    Width="150"
                    Height="40"
                    Margin="0,3"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    FontSize="16" />
            </DockPanel>
            <Label
                Name="lblError"
                Margin="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                FontSize="15"
                Foreground="Red" />
            <DockPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch">
                <Button
                    Name="btnCancelc"
                    Width="70"
                    Height="30"
                    Margin="10"
                    Click="btnCancelc_Click"
                    CommandParameter="{Binding}"
                    FontSize="18"
                    Style="{StaticResource ButtonAddStyle}">
                    Cancel
                </Button>
                <Button
                    x:Name="btnOKc"
                    Width="70"
                    Height="30"
                    Background="White"
                    Click="btnOKc_Click"
                    CommandParameter="{Binding}"
                    FontSize="18"
                    FontWeight="Medium"
                    Foreground="Black"
                    Style="{StaticResource ButtonAddStyle}">
                    OK
                </Button>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
