<Window x:Class="wpf.AddEditProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpf"
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=local:AddEditProduct, IsDesignTimeCreatable=True}"
        Title="AddEditProduct" FontSize="25" Height="350" Width="390"
        Icon="resources/bookshop2.png">

    <Window.Resources>
        <Style x:Key="ButtonAddStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderBrush" Value="#08091c"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#08091c"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="-10" Color="#E91E63" RenderingBias="Quality" BlurRadius="10"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#08091c">
        <StackPanel Margin="20">
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Name:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Margin="0,3" Name="tbName" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Author:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Margin="0,3" Name="tbAuthor" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Price:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Margin="0,3" Name="tbPrice" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <DockPanel Margin="1">
                <Label Margin="2" FontSize="20" Foreground="White" FontWeight="Medium" Content="Available:" ></Label>
                <TextBox HorizontalAlignment="Right" Width="150" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  Margin="0,3" Name="tbAvailable" TextChanged="ValidateTextInput"/>
            </DockPanel>
            <Label Name="lblError" HorizontalAlignment="Right" VerticalAlignment="Stretch" Foreground="Red" FontSize="15" Margin="2"/>
            <DockPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button Margin="10" Height="30" Width="70" Name="btnCancelp" Content="Cancel" Style="{StaticResource ButtonAddStyle}" FontSize="18" CommandParameter="{Binding}" Click="btnCancelp_Click"></Button>
                <Button Background="White" Foreground="Black" FontWeight="Medium" Content="{Binding MyProperty,Mode=TwoWay}" Height="30" Width="70"  Style="{StaticResource ButtonAddStyle}" FontSize="18" CommandParameter="{Binding}" Click="btnOKp_Click"/>
                <!--<Button Margin="10"  Height="50" Width="120" Background="Black" Click="BBBB"/>-->
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
