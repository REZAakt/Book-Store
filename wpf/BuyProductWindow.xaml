<Window
    x:Class="wpf.BuyProductWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="BuyProductWindow"
    Width="800"
    Height="450"
    Background="#08091c"
    Icon="resources/bookshop2.png"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ThreeDBorderWindow"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ButtonAddStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Height" Value="50" />
            <Setter Property="BorderBrush" Value="#08091c" />
            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#08091c" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            RenderingBias="Quality"
                                            ShadowDepth="-10"
                                            Color="#E91E63" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="#08091c">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  لیست کتاب‌ها  -->
        <ui:DataGrid
            x:Name="ProductsGrid"
            Grid.Row="0"
            AutoGenerateColumns="False"
            Background="#181929"
            Foreground="White"
            IsReadOnly="True"
            SelectionMode="Single">
            <ui:DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="Name" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Author}"
                    Header="Author" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Price}"
                    Header="Price" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding AvailableCount}"
                    Header="Available" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>

        <!--  تعداد و دکمه‌ها  -->
        <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Foreground="White"
                Text="Count:" />
            <TextBox
                x:Name="txtQuantity"
                Width="80"
                Margin="0,0,10,0" />
            <ui:Button
                Width="70"
                Height="30"
                Margin="0,0,5,0"
                Click="btnConfirm_Click"
                CommandParameter="{Binding}"
                Content="Buy"
                Style="{StaticResource ButtonAddStyle}" />
            <ui:Button
                Width="70"
                Height="30"
                Click="btnCancel_Click"
                CommandParameter="{Binding}"
                Content="Cancel"
                Style="{StaticResource ButtonAddStyle}" />
        </StackPanel>

        <!--  پیام خطا  -->
        <TextBlock
            x:Name="txtError"
            Grid.Row="2"
            Margin="0,10,0,0"
            Foreground="Red"
            TextWrapping="Wrap" />
    </Grid>
</Window>
