<Window
    x:Class="wpf.CustomerPurchasesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CustomerPurchasesWindow"
    Width="950"
    Height="500"
    Background="#08091c"
    Icon="resources/bookshop2.png"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="ThreeDBorderWindow"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ButtonAddStyle" TargetType="Button">
            <Setter Property="Background" Value="#E91E63" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Height" Value="50" />
            <Setter Property="BorderBrush" Value="#08091c" />
            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#08091c" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect
                                            BlurRadius="10"
                                            RenderingBias="Quality"
                                            ShadowDepth="-10"
                                            Color="#E91E63" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid Margin="10" Background="#08091c">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <ui:DataGrid
            x:Name="PurchasesGrid"
            AutoGenerateColumns="False"
            Background="#181929"
            Foreground="White"
            IsReadOnly="True">
            <ui:DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding BookName}"
                    Header="Book" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Author}"
                    Header="Author" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Price}"
                    Header="Price" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Quantity}"
                    Header="Quantity" />
                <DataGridTextColumn
                    Width="250"
                    Binding="{Binding PurchaseDate}"
                    Header="Date" />
            </ui:DataGrid.Columns>
        </ui:DataGrid>
        <Button
            Grid.Row="1"
            Width="70"
            Height="30"
            Margin="10,10,10,10"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="btnCansel_Click"
            CommandParameter="{Binding}"
            Content="Cancel"
            FontSize="18"
            Style="{StaticResource ButtonAddStyle}" />
    </Grid>
</Window>
